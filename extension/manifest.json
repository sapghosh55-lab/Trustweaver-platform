{
  "manifest_version": 3,
  "name": "TrustWeaver / Hackmatrix Shield",
  "version": "1.0.0",
  "description": "Real-time AI-powered web trust scoring, phishing detection, and cryptographic validation.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrustWeaver Shield"
  }
}

